  "fixed_sql": [
    {
      "name": "app_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"template_key\" TEXT NULL, \"title\" TEXT NULL, \"icon\" TEXT NOT NULL DEFAULT 'check', \"schedule_type\" TEXT NOT NULL DEFAULT 'daily', \"weekdays_mask\" INTEGER NOT NULL DEFAULT 127, \"target_per_day\" INTEGER NOT NULL DEFAULT 1, \"reminder_minutes\" INTEGER NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"is_locked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_locked\" IN (0, 1)), \"archived_at\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_logs\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id), \"local_day\" TEXT NOT NULL, \"count\" INTEGER NOT NULL DEFAULT 1, \"completed_at\" INTEGER NOT NULL, \"source\" TEXT NOT NULL DEFAULT 'app', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"habit_id\", \"local_day\"));"
        }
      ]
    },
    {
      "name": "checkins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"checkins\" (\"id\" TEXT NOT NULL, \"local_day\" TEXT NOT NULL, \"mood_level\" INTEGER NOT NULL, \"note\" TEXT NULL, \"tags\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'app', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "exercise_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_sessions\" (\"id\" TEXT NOT NULL, \"exercise_key\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"duration_s\" INTEGER NOT NULL DEFAULT 0, \"local_day\" TEXT NOT NULL, \"journal_text\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wallet",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallet\" (\"id\" INTEGER NOT NULL, \"energy\" INTEGER NOT NULL DEFAULT 0, \"coins\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wallet_ledger",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallet_ledger\" (\"id\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"ref_id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"reason\", \"ref_id\"));"
        }
      ]
    },
    {
      "name": "adventures",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"adventures\" (\"id\" TEXT NOT NULL, \"location_key\" TEXT NOT NULL, \"energy_cost\" INTEGER NOT NULL, \"started_at\" INTEGER NOT NULL, \"ends_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'active', \"reward_coins\" INTEGER NOT NULL DEFAULT 0, \"reward_item_key\" TEXT NULL, \"story_key\" TEXT NULL, \"claimed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "inventory",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory\" (\"item_key\" TEXT NOT NULL, \"acquired_at\" INTEGER NOT NULL, \"source\" TEXT NOT NULL, \"equipped\" INTEGER NOT NULL DEFAULT 0 CHECK (\"equipped\" IN (0, 1)), \"slot\" TEXT NOT NULL, PRIMARY KEY (\"item_key\"));"
        }
      ]
    },
    {
      "name": "streak_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"streak_state\" (\"id\" INTEGER NOT NULL, \"current\" INTEGER NOT NULL DEFAULT 0, \"longest\" INTEGER NOT NULL DEFAULT 0, \"last_active_day\" TEXT NULL, \"freezes_left\" INTEGER NOT NULL DEFAULT 1, \"freeze_month\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "safety_flags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"safety_flags\" (\"id\" TEXT NOT NULL, \"local_day\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"shown_at\" INTEGER NULL, \"dismissed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notification_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notification_log\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"scheduled_for\" INTEGER NOT NULL, \"delivered_at\" INTEGER NULL, \"opened_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entitlement_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entitlement_cache\" (\"id\" INTEGER NOT NULL, \"state_json\" TEXT NOT NULL, \"signature\" TEXT NOT NULL, \"kid\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, \"pending_verification_until\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NOT NULL, \"last_error\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "analytics_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"analytics_queue\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"props\" TEXT NOT NULL, \"ts\" INTEGER NOT NULL, \"session_id\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "content_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"content_cache\" (\"pack_key\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"pack_key\"));"
        }
      ]
    }
  ]
