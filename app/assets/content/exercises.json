  "entries": [
    {
      "key": "breathing_basic",
      "premium": false,
      "duration_s": 120,
      "type": "timer_steps",
      "collection": "stress",
      "disclaimer_key": "disclaimer.exercise",
      "steps": [
        {
          "text_key": "exercise.breathing_basic.step.intro",
          "seconds": 6,
          "animation": "none"
        },
        {
          "text_key": "exercise.breathing_basic.step.inhale",
          "seconds": 4,
          "animation": "inhale",
          "repeat": 6
        },
        {
          "text_key": "exercise.breathing_basic.step.hold",
          "seconds": 4,
          "animation": "hold",
          "repeat": 6
        },
        {
          "text_key": "exercise.breathing_basic.step.exhale",
          "seconds": 6,
          "animation": "exhale",
          "repeat": 6
        },
        {
          "text_key": "exercise.breathing_basic.step.outro",
          "seconds": 5,
          "animation": "none"
        }
      ]
    },
