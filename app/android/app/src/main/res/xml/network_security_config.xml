<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only; no certificate pinning on purpose (docs/80 §2). Debug builds may reach the
     emulator host over cleartext through src/debug/res/xml override. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
