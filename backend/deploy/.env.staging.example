APP_ENV=staging
POSTGRES_PASSWORD=change-me
STAGING_API_DOMAIN=staging-api.example.ir
API_DOMAIN=staging-api.example.ir
LOG_LEVEL=debug
DB_MAX_CONNS=10
SIGNING_KEYS_DIR=/keys
DEVICE_HASH_SALT=staging-only-salt
DATA_ENC_KEY=            # openssl rand -base64 32 (a different key from production)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=     # bcrypt hash; admin-cli hash-password
ADMIN_IP_ALLOWLIST=
BILLING_FAKE_ENABLED=true
BILLING_BAZAAR_ENABLED=false
BILLING_MYKET_ENABLED=false
CONFIG_DATA_DIR=/config-data
SMS_PROVIDER=log          # staging only: the OTP code is written to the log
BACKUP_MAX_BYTES=5242880
