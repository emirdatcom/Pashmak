APP_ENV=prod
POSTGRES_PASSWORD=change-me
API_DOMAIN=api.example.ir
LOG_LEVEL=info
DB_MAX_CONNS=10
SIGNING_KEYS_DIR=/keys
DEVICE_HASH_SALT=change-me
DATA_ENC_KEY=            # base64 of 32 random bytes: openssl rand -base64 32
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=     # bcrypt hash
ADMIN_IP_ALLOWLIST=
# Billing (docs/10 §8). Keep disabled until verified against a real test purchase.
BILLING_BAZAAR_ENABLED=false
BILLING_MYKET_ENABLED=false
BAZAAR_PACKAGE_NAME=
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=
MYKET_PACKAGE_NAME=
MYKET_ACCESS_TOKEN=
# BILLING_FAKE_ENABLED=true   # dev/staging only; refused when APP_ENV=prod
CONFIG_DATA_DIR=/config-data   # set automatically in the image; use ../config-data when running locally
# Phase 2: phone linking (OTP) and backup
SMS_PROVIDER=            # empty = phone endpoints disabled; kavenegar in prod (log = dev only)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
BACKUP_STORAGE=db        # db | s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
