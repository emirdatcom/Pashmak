APP_ENV=prod
POSTGRES_PASSWORD=change-me
API_DOMAIN=api.example.ir
LOG_LEVEL=info
DB_MAX_CONNS=10
SIGNING_KEYS_DIR=/keys
DEVICE_HASH_SALT=change-me
DATA_ENC_KEY=            # base64 of 32 random bytes: openssl rand -base64 32
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=     # bcrypt hash
ADMIN_IP_ALLOWLIST=
# Billing (docs/10 §8). Keep disabled until verified against a real test purchase.
BILLING_BAZAAR_ENABLED=false
BILLING_MYKET_ENABLED=false
BAZAAR_PACKAGE_NAME=
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=
MYKET_PACKAGE_NAME=
MYKET_ACCESS_TOKEN=
# BILLING_FAKE_ENABLED=true   # dev/staging only; refused when APP_ENV=prod
CONFIG_DATA_DIR=/config-data   # set automatically in the image; use ../config-data when running locally
# Phase 2: phone linking (OTP) and backup
SMS_PROVIDER=            # empty = phone endpoints disabled; smsir in prod (log = dev only)
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=   # approved verify template id
SMSIR_OTP_PARAM_NAME=CODE
SMSIR_LINE_NUMBER=       # service line, needed for operational alerts
ALERT_PHONES=            # comma-separated on-call numbers for alert SMS (alert-relay)
BACKUP_MAX_BYTES=5242880 # largest user backup (blob lives in Postgres, no object storage)
ALERT_RELAY_TOKEN=       # shared secret between alertmanager and alert-relay (also put it in deploy/secrets/alert_relay_token)
# Database backup (backend/deploy/backup)
AGE_RECIPIENT=           # age public key (private key stays offline)
OFFSITE_TARGET=          # user@second-server:/backups  (empty = no offsite copy)
OFFSITE_SSH_KEY=/offsite/offsite_key
