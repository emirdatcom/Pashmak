{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/config.schema.json",
  "title": "Remote config payload",
  "description": "Every key has a bundled default in config-data/config/default.json. Unknown keys are rejected so typos fail at publish time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["limits", "pricing", "trial", "paywall", "entitlement", "economy", "adventure", "growth", "quests", "shop", "onboarding", "streak", "notifications", "safety", "features", "support", "update"],
  "$defs": {
    "productId": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
    "key": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
    "hhmm": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"},
    "posInt": {"type": "integer", "minimum": 1},
    "nonNegInt": {"type": "integer", "minimum": 0}
  },
  "properties": {
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["free_active_habits", "free_custom_habits", "free_exercises", "free_adventure_locations"],
      "properties": {
        "free_active_habits": {"$ref": "#/$defs/nonNegInt", "description": "Active habits free users may keep (docs/60 §3)."},
        "free_custom_habits": {"$ref": "#/$defs/nonNegInt"},
        "free_exercises": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true},
        "free_adventure_locations": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["plans", "monthly_anchor_product"],
      "properties": {
        "plans": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["product_id", "market_sku", "display_price_toman", "badge_key", "highlight"],
            "properties": {
              "product_id": {"$ref": "#/$defs/productId"},
              "market_sku": {
                "type": "object", "additionalProperties": false, "required": ["bazaar", "myket"],
                "properties": {"bazaar": {"type": "string", "minLength": 1}, "myket": {"type": "string", "minLength": 1}}
              },
              "display_price_toman": {"$ref": "#/$defs/posInt"},
              "badge_key": {"type": "string"},
              "highlight": {"type": "boolean"}
            }
          }
        },
        "monthly_anchor_product": {"$ref": "#/$defs/productId"}
      }
    },
    "trial": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "days", "reminder_day"],
      "properties": {
        "enabled": {"type": "boolean"},
        "days": {"type": "integer", "minimum": 1, "maximum": 30},
        "reminder_day": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    },
    "paywall": {
      "type": "object", "additionalProperties": false, "required": ["variant", "triggers", "cooldown_hours"],
      "properties": {
        "variant": {"$ref": "#/$defs/key"},
        "triggers": {
          "type": "object", "additionalProperties": false,
          "required": ["fourth_habit", "custom_habit", "premium_exercise", "premium_location", "premium_item", "stats_deep", "trial_end", "settings"],
          "properties": {
            "fourth_habit": {"type": "boolean"}, "custom_habit": {"type": "boolean"},
            "premium_exercise": {"type": "boolean"}, "premium_location": {"type": "boolean"},
            "premium_item": {"type": "boolean"}, "stats_deep": {"type": "boolean"},
            "trial_end": {"type": "boolean"}, "settings": {"type": "boolean"}
          }
        },
        "cooldown_hours": {"$ref": "#/$defs/nonNegInt"}
      }
    },
    "entitlement": {
      "type": "object", "additionalProperties": false, "required": ["grace_days", "offline_validity_days", "pending_verification_hours"],
      "properties": {
        "grace_days": {"$ref": "#/$defs/nonNegInt"},
        "offline_validity_days": {"$ref": "#/$defs/posInt"},
        "pending_verification_hours": {"$ref": "#/$defs/posInt"}
      }
    },
    "economy": {
      "type": "object", "additionalProperties": false,
      "required": ["energy_per_goal", "energy_per_checkin", "energy_per_exercise", "exercise_rewards_per_day", "energy_cap"],
      "properties": {
        "energy_per_goal": {"$ref": "#/$defs/nonNegInt"},
        "energy_per_checkin": {"$ref": "#/$defs/nonNegInt"},
        "energy_per_exercise": {"$ref": "#/$defs/nonNegInt"},
        "exercise_rewards_per_day": {"$ref": "#/$defs/nonNegInt"},
        "energy_cap": {"$ref": "#/$defs/posInt"}
      }
    },
    "adventure": {
      "type": "object", "additionalProperties": false, "required": ["locations", "daily_energy_target"],
      "properties": {
        "daily_energy_target": {"$ref": "#/$defs/posInt"},
        "locations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["location_key", "energy_cost", "duration_minutes", "coins_min", "coins_max", "item_drop_rate"],
            "properties": {
              "location_key": {"$ref": "#/$defs/key"},
              "energy_cost": {"$ref": "#/$defs/nonNegInt"},
              "duration_minutes": {"$ref": "#/$defs/posInt"},
              "coins_min": {"$ref": "#/$defs/nonNegInt"},
              "coins_max": {"$ref": "#/$defs/nonNegInt"},
              "item_drop_rate": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "growth": {
      "type": "object", "additionalProperties": false, "required": ["thresholds"],
      "properties": {"thresholds": {"type": "object", "additionalProperties": false, "required": ["young", "adult"],
        "properties": {"young": {"$ref": "#/$defs/posInt"}, "adult": {"$ref": "#/$defs/posInt"}}}}
    },
    "quests": {
      "type": "object", "additionalProperties": false, "required": ["daily_count", "daily_reward_coins"],
      "properties": {"daily_count": {"type": "integer", "minimum": 1, "maximum": 6}, "daily_reward_coins": {"$ref": "#/$defs/nonNegInt"}}
    },
    "shop": {
      "type": "object", "additionalProperties": false, "required": ["rotation_size", "refresh_cost", "sell_ratio"],
      "properties": {"rotation_size": {"$ref": "#/$defs/posInt"}, "refresh_cost": {"$ref": "#/$defs/nonNegInt"},
        "sell_ratio": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "onboarding": {
      "type": "object", "additionalProperties": false, "required": ["recommend_count_free", "recommend_count_trial", "recommender"],
      "properties": {
        "recommend_count_free": {"$ref": "#/$defs/posInt"}, "recommend_count_trial": {"$ref": "#/$defs/posInt"},
        "recommender": {"type": "object", "additionalProperties": false,
          "required": ["area_selected", "answer_rarely", "answer_sometimes", "need_weight", "tag_weight", "difficulty_penalty", "chronotype_bonus"],
          "properties": {"area_selected": {"$ref": "#/$defs/nonNegInt"}, "answer_rarely": {"$ref": "#/$defs/nonNegInt"}, "answer_sometimes": {"$ref": "#/$defs/nonNegInt"},
            "need_weight": {"$ref": "#/$defs/nonNegInt"}, "tag_weight": {"$ref": "#/$defs/nonNegInt"}, "difficulty_penalty": {"$ref": "#/$defs/nonNegInt"}, "chronotype_bonus": {"$ref": "#/$defs/nonNegInt"}}}
      }
    },
    "streak": {
      "type": "object", "additionalProperties": false, "required": ["freezes_per_month"],
      "properties": {"freezes_per_month": {"$ref": "#/$defs/nonNegInt"}}
    },
    "notifications": {
      "type": "object", "additionalProperties": false,
      "required": ["max_per_day", "default_morning_time", "default_evening_time", "default_quiet", "comeback_days", "ignore_threshold", "types_enabled"],
      "properties": {
        "max_per_day": {"$ref": "#/$defs/nonNegInt"},
        "default_morning_time": {"$ref": "#/$defs/hhmm"},
        "default_evening_time": {"$ref": "#/$defs/hhmm"},
        "default_quiet": {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {"start": {"$ref": "#/$defs/hhmm"}, "end": {"$ref": "#/$defs/hhmm"}}
        },
        "comeback_days": {"type": "array", "items": {"$ref": "#/$defs/posInt"}, "uniqueItems": true},
        "ignore_threshold": {"$ref": "#/$defs/posInt"},
        "types_enabled": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "Remote kill switch per notification type."}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["low_mood_level", "low_mood_count", "low_mood_window_days", "card_cooldown_hours"],
      "properties": {
        "low_mood_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "low_mood_count": {"$ref": "#/$defs/posInt"},
        "low_mood_window_days": {"$ref": "#/$defs/posInt"},
        "card_cooldown_hours": {"$ref": "#/$defs/nonNegInt"}
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["rive_cat", "widgets", "backup", "phone_link", "seasonal_packs", "stats_deep", "pause_mode"],
      "properties": {
        "rive_cat": {"type": "boolean"}, "widgets": {"type": "boolean"}, "backup": {"type": "boolean"},
        "phone_link": {"type": "boolean"}, "seasonal_packs": {"type": "boolean"}, "stats_deep": {"type": "boolean"}, "pause_mode": {"type": "boolean"}
      }
    },
    "support": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "hours", "timezone", "max_message_chars", "poll_schedule", "unanswered_alert"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hours": {"type": "array", "maxItems": 14, "items": {
          "type": "object", "additionalProperties": false, "required": ["weekday", "from", "to"],
          "properties": {"weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "from": {"$ref": "#/$defs/hhmm"}, "to": {"$ref": "#/$defs/hhmm"}}}},
        "timezone": {"type": "string", "minLength": 1},
        "max_message_chars": {"type": "integer", "minimum": 100, "maximum": 5000},
        "poll_schedule": {"type": "object", "additionalProperties": false,
          "required": ["first_interval_minutes", "first_window_hours", "second_interval_hours", "stop_after_days"],
          "properties": {"first_interval_minutes": {"$ref": "#/$defs/posInt"}, "first_window_hours": {"$ref": "#/$defs/posInt"},
                         "second_interval_hours": {"$ref": "#/$defs/posInt"}, "stop_after_days": {"$ref": "#/$defs/posInt"}}},
        "unanswered_alert": {"type": "object", "additionalProperties": false, "required": ["count", "minutes"],
          "properties": {"count": {"$ref": "#/$defs/posInt"}, "minutes": {"$ref": "#/$defs/posInt"}}}
      }
    },
    "update": {
      "type": "object", "additionalProperties": false, "required": ["min_supported_version", "recommended_version"],
      "properties": {
        "min_supported_version": {"$ref": "#/$defs/version"},
        "recommended_version": {"$ref": "#/$defs/version"}
      }
    }
  }
}
