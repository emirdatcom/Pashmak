{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adventures pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_key",
    "version",
    "pack_schema_version",
    "locale",
    "min_app_version",
    "entries"
  ],
  "properties": {
    "pack_key": {
      "const": "adventures"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locations"
      ],
      "properties": {
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location_key",
              "name_key",
              "bg_asset",
              "stories",
              "possible_items"
            ],
            "properties": {
              "location_key": {
                "enum": [
                  "alley",
                  "rooftop",
                  "courtyard",
                  "bazaar",
                  "garden"
                ]
              },
              "name_key": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
              },
              "bg_asset": {
                "type": "string"
              },
              "stories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "story_key",
                    "text_key",
                    "weight"
                  ],
                  "properties": {
                    "story_key": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,64}$"
                    },
                    "text_key": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "possible_items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]{1,64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
