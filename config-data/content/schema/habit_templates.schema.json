{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "habit_templates pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_key",
    "version",
    "pack_schema_version",
    "locale",
    "min_app_version",
    "entries"
  ],
  "properties": {
    "pack_key": {
      "const": "habit_templates"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "icon",
          "title_key",
          "schedule_type",
          "default_reminder_minutes"
        ],
        "properties": {
          "key": {
            "enum": [
              "water",
              "sleep",
              "short_break",
              "walk",
              "healthy_food",
              "medicine",
              "loved_ones"
            ]
          },
          "icon": {
            "type": "string"
          },
          "title_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "schedule_type": {
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "default_reminder_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1439
          }
        }
      }
    }
  }
}
