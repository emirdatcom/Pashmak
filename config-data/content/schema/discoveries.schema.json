{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discoveries pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_key",
    "version",
    "pack_schema_version",
    "locale",
    "min_app_version",
    "entries"
  ],
  "properties": {
    "pack_key": {
      "const": "discoveries"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name_key",
          "category"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "name_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "category": {
            "enum": [
              "food",
              "plant",
              "antique",
              "sound",
              "sky"
            ]
          }
        }
      }
    }
  }
}
