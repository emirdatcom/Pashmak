{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quests_daily pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_key",
    "version",
    "pack_schema_version",
    "locale",
    "min_app_version",
    "entries"
  ],
  "properties": {
    "pack_key": {
      "const": "quests_daily"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title_key",
          "metric",
          "target",
          "route"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "title_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "metric": {
            "enum": [
              "claim",
              "checkin_today",
              "exercise_today",
              "goals_done_today",
              "reflection_today",
              "energy_today",
              "shop_visit_today",
              "cat_visit_today"
            ]
          },
          "target": {
            "type": "integer",
            "minimum": 1
          },
          "route": {
            "type": "string",
            "pattern": "^/[a-z0-9/_-]*$"
          },
          "fixed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
