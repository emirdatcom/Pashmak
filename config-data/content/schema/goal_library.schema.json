{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "goal_library pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_key",
    "version",
    "pack_schema_version",
    "locale",
    "min_app_version",
    "entries"
  ],
  "properties": {
    "pack_key": {
      "const": "goal_library"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title_key",
          "icon",
          "area_key",
          "tabs",
          "difficulty",
          "minutes",
          "default_time_of_day",
          "default_repeat",
          "need_tags"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "title_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$"
          },
          "area_key": {
            "enum": [
              "sleep",
              "calm",
              "movement",
              "nutrition",
              "connection",
              "focus",
              "self_kindness",
              "home"
            ]
          },
          "tabs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "easy_wins",
                "calm",
                "connection",
                "gratitude",
                "health",
                "sleep",
                "movement",
                "tidy"
              ]
            }
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "default_time_of_day": {
            "enum": [
              "morning",
              "afternoon",
              "evening",
              "any"
            ]
          },
          "default_repeat": {
            "type": "string",
            "pattern": "^(daily|once|weekdays:[0-6](,[0-6])*)$"
          },
          "need_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(low|mid)_[a-z_]+$"
            }
          }
        }
      }
    }
  }
}
