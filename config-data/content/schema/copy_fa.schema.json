{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "copy_fa pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_key",
    "version",
    "pack_schema_version",
    "locale",
    "min_app_version",
    "entries"
  ],
  "properties": {
    "pack_key": {
      "const": "copy_fa"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "fa"
    },
    "min_app_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    }
  }
}
